// The online room server (see worker.ts). Deployed by .github/workflows/server.yml;
// run it on this computer with: npm run server
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dangopoly-server",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" } // the public room list
    ]
  },
  // SQLite-backed Durable Objects are the kind included in Cloudflare's free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDirectory"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://danglayloi1.github.io,http://localhost:5173,http://127.0.0.1:5173"
  },
  "observability": { "enabled": true }
}
